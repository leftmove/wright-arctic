# Copy to ignored .env. Process environment overrides dotenv and mounted secrets.
WRIGHT_ARCTIC_APP_NAME=wright-arctic
WRIGHT_ARCTIC_DEBUG=false

# Supabase identity. Configure all three; unconfigured protected routes fail closed.
# WRIGHT_ARCTIC_AUTH_ISSUER=https://PROJECT.supabase.co/auth/v1
# WRIGHT_ARCTIC_AUTH_JWKS_URL=https://PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# WRIGHT_ARCTIC_AUTH_PUBLISHABLE_KEY=sb_publishable_...
# WRIGHT_ARCTIC_AUTH_ALGORITHM=ES256

# Private Postgres runtime login, with membership in arctic_catalog.
# WRIGHT_ARCTIC_DOCUMENTS_DATABASE_URL=postgresql://LOGIN:PASSWORD@HOST:5432/postgres?sslmode=require
# Admin connection is used only by `uv run python -m app.services.catalog setup`.
# First setup discards the old documents schema. No legacy data is copied.
# WRIGHT_ARCTIC_DOCUMENTS_SETUP_URL=postgresql://ADMIN:PASSWORD@HOST:5432/postgres?sslmode=require
# Optional dedicated direct/session URL (port 5432), if LISTEN needs a different host.
# WRIGHT_ARCTIC_DOCUMENTS_LISTENER_URL=
# WRIGHT_ARCTIC_DOCUMENTS_POOL_SIZE=4

# Private R2 buckets. Use separate credentials scoped to each bucket.
# Configure the endpoint and all four credential fields together.
# WRIGHT_ARCTIC_STORAGE_ENDPOINT_URL=https://ACCOUNT.r2.cloudflarestorage.com
# WRIGHT_ARCTIC_STORAGE_REGION=auto
# WRIGHT_ARCTIC_DOCUMENTS_BUCKET=wright-documents
# WRIGHT_ARCTIC_IMAGES_BUCKET=wright-images
# WRIGHT_ARCTIC_DOCUMENTS_ACCESS_KEY_ID=...
# WRIGHT_ARCTIC_DOCUMENTS_SECRET_ACCESS_KEY=...
# WRIGHT_ARCTIC_IMAGES_ACCESS_KEY_ID=...
# WRIGHT_ARCTIC_IMAGES_SECRET_ACCESS_KEY=...
# WRIGHT_ARCTIC_STORAGE_ADDRESSING_STYLE=path
# WRIGHT_ARCTIC_STORAGE_PRESIGN_SECONDS=300
# WRIGHT_ARCTIC_IMAGE_DAILY_QUOTA=100
# WRIGHT_ARCTIC_IMAGE_TOTAL_QUOTA=300
# WRIGHT_ARCTIC_TRASH_RETENTION_DAYS=3

# Optional application configuration; this API key is not authentication.
# WRIGHT_ARCTIC_API_KEY=...
# Mounted secrets: export WRIGHT_ARCTIC_SECRETS_DIR=/run/secrets in the process.
# Files use the prefixed setting name, e.g. wright_arctic_documents_secret_access_key.
