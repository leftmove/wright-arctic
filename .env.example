# Copy to .env for local configuration. Environment variables take precedence.
WRIGHT_ARCTIC_APP_NAME = wright - arctic
WRIGHT_ARCTIC_DEBUG = false

# Optional secret placeholder; this does not enable API authentication.
# WRIGHT_ARCTIC_API_KEY=replace-with-a-real-secret

# For mounted secret files, set this in the process environment:
# export WRIGHT_ARCTIC_SECRETS_DIR=/run/secrets
# A file named wright_arctic_api_key supplies WRIGHT_ARCTIC_API_KEY.

# Image storage uses the S3 API. Leave the required values unset to boot
# without it; image routes then respond 503. Set them together.
#
# Cloudflare R2:
# WRIGHT_ARCTIC_STORAGE_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# WRIGHT_ARCTIC_STORAGE_REGION=auto
# WRIGHT_ARCTIC_STORAGE_BUCKET=wright-arctic-images
# WRIGHT_ARCTIC_STORAGE_ACCESS_KEY_ID=
# WRIGHT_ARCTIC_STORAGE_SECRET_ACCESS_KEY=
#
# AWS S3 (virtual-hosted URLs):
# WRIGHT_ARCTIC_STORAGE_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# WRIGHT_ARCTIC_STORAGE_REGION=us-east-1
# WRIGHT_ARCTIC_STORAGE_ADDRESSING_STYLE=virtual
#
# Optional. When set, image URLs are public and do not expire, and the host
# must already be able to read the bucket. When unset, responses carry
# presigned URLs.
# WRIGHT_ARCTIC_STORAGE_PUBLIC_BASE_URL=https://images.example.com
# WRIGHT_ARCTIC_STORAGE_ADDRESSING_STYLE=path
# WRIGHT_ARCTIC_STORAGE_PRESIGN_SECONDS=900
#
# Mounted secret files for the keys above:
# wright_arctic_storage_access_key_id
# wright_arctic_storage_secret_access_key
