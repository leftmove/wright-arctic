# Copy to .env for local configuration. Environment variables take precedence.
WRIGHT_ARCTIC_APP_NAME=wright-arctic
WRIGHT_ARCTIC_DEBUG=false

# Optional secret placeholder; this does not enable API authentication.
# WRIGHT_ARCTIC_API_KEY=replace-with-a-real-secret

# For mounted secret files, set this in the process environment:
# export WRIGHT_ARCTIC_SECRETS_DIR=/run/secrets
# A file named wright_arctic_api_key supplies WRIGHT_ARCTIC_API_KEY.
